{
  "manifest_version": 3,
  "name": "Sales Navigator Visible Lead Exporter",
  "version": "1.0.0",
  "description": "Export lead information rendered on the current Sales Navigator results page.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.linkedin.com/sales/*"
  ],
  "action": {
    "default_title": "Sales Navigator Lead Exporter"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/sales/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/sales/lead/*"
      ],
      "js": [
        "src/lead-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
